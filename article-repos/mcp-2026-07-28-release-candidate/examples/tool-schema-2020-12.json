{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 10
    },
    "mode": {
      "oneOf": [
        {
          "const": "fast"
        },
        {
          "const": "deep"
        }
      ]
    }
  },
  "required": ["query"],
  "additionalProperties": false
}
